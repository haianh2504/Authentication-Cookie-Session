SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/your_database
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=replace-me

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-me
ADMIN_SEED_ENABLED=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-me
SUPABASE_STORAGE_BUCKET=gallery

CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-XSRF-TOKEN
CSRF_PARAMETER_NAME=_csrf
CSRF_COOKIE_PATH=/
CSRF_COOKIE_SAME_SITE=Lax
CSRF_COOKIE_DOMAIN=
CSRF_COOKIE_SECURE=false
CSRF_TOKEN_BYTES=32
